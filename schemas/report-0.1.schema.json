{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postvibeclarity.dev/schemas/report-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "toolkitVersion",
    "partial",
    "manifest",
    "checkExecutions",
    "coverageGaps",
    "findings",
    "summary",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "runId": { "type": "string", "pattern": "^pvc-[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "toolkitVersion": { "$ref": "#/$defs/version" },
    "partial": { "type": "boolean" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "checkExecutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/checkExecution" }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageGap" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "disclaimer": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(?:unknown|[0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    "domain": {
      "enum": [
        "product-ux",
        "security-privacy",
        "data-correctness",
        "reliability-recovery",
        "operations-observability",
        "performance-cost",
        "maintainability-change-safety",
        "release-delivery",
        "policy-business-essentials"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/domain" }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary"],
      "properties": {
        "kind": { "enum": ["file", "command", "behavior", "human"] },
        "summary": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["confirmed", "likely"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectRoot", "generatedAt", "artifacts", "frameworks", "services", "capabilities"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "projectRoot": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
        "frameworks": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
        "services": { "type": "array", "items": { "$ref": "#/$defs/detection" } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/detection" } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "checkId",
        "checkVersion",
        "skillVersion",
        "domains",
        "actionLevel",
        "outcome",
        "title",
        "impact",
        "evidence",
        "evidenceConfidence",
        "applicability",
        "recommendation",
        "verification",
        "humanReviewRequired"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "checkId": { "type": "string", "minLength": 1 },
        "checkVersion": { "$ref": "#/$defs/version" },
        "skillVersion": { "$ref": "#/$defs/version" },
        "domains": { "$ref": "#/$defs/domains" },
        "actionLevel": {
          "enum": ["stop-before-launch", "resolve-before-launch", "plan-soon", "improve-when-appropriate", "human-review-needed"]
        },
        "outcome": {
          "enum": ["passed", "failed", "likely-issue", "unverified", "not-applicable", "risk-accepted", "resolved-and-rechecked"]
        },
        "title": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "evidenceConfidence": { "enum": ["confirmed", "strong-indication", "possible", "insufficient"] },
        "applicability": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "humanReviewRequired": { "type": "boolean" },
        "unverifiedBoundaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checkExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "checkVersion", "skillId", "skillVersion", "domains", "status", "findingIds"],
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "checkVersion": { "$ref": "#/$defs/version" },
        "skillId": { "type": "string", "minLength": 1 },
        "skillVersion": { "$ref": "#/$defs/version" },
        "domains": { "$ref": "#/$defs/domains" },
        "status": { "enum": ["completed", "unavailable", "failed", "unverified"] },
        "findingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverageGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "domains", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["unavailable", "failed", "unverified"] },
        "domains": { "$ref": "#/$defs/domains" },
        "reason": { "type": "string", "minLength": 1 },
        "checkId": { "type": "string", "minLength": 1 },
        "skillId": { "type": "string", "minLength": 1 }
      }
    },
    "countRecord": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "checkStatusSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "unavailable", "failed", "unverified"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byActionLevel", "byOutcome", "byCheckStatus", "byDomain"],
      "properties": {
        "byActionLevel": { "$ref": "#/$defs/countRecord" },
        "byOutcome": { "$ref": "#/$defs/countRecord" },
        "byCheckStatus": { "$ref": "#/$defs/checkStatusSummary" },
        "byDomain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product-ux",
            "security-privacy",
            "data-correctness",
            "reliability-recovery",
            "operations-observability",
            "performance-cost",
            "maintainability-change-safety",
            "release-delivery",
            "policy-business-essentials"
          ],
          "properties": {
            "product-ux": { "$ref": "#/$defs/checkStatusSummary" },
            "security-privacy": { "$ref": "#/$defs/checkStatusSummary" },
            "data-correctness": { "$ref": "#/$defs/checkStatusSummary" },
            "reliability-recovery": { "$ref": "#/$defs/checkStatusSummary" },
            "operations-observability": { "$ref": "#/$defs/checkStatusSummary" },
            "performance-cost": { "$ref": "#/$defs/checkStatusSummary" },
            "maintainability-change-safety": { "$ref": "#/$defs/checkStatusSummary" },
            "release-delivery": { "$ref": "#/$defs/checkStatusSummary" },
            "policy-business-essentials": { "$ref": "#/$defs/checkStatusSummary" }
          }
        }
      }
    }
  }
}
