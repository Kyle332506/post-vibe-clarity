{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postvibeclarity.dev/schemas/verification-execution-0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "executionId",
    "status",
    "planId",
    "planFingerprint",
    "toolkitVersion",
    "projectRoot",
    "startedAt",
    "completedAt",
    "removedEnvironmentVariables",
    "results",
    "coverageGaps",
    "observationBoundary",
    "containmentWarning",
    "disclaimer"
  ],
  "properties": {
    "schemaId": { "const": "postvibe-verification-execution/0.1" },
    "schemaVersion": { "const": "0.1" },
    "executionId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["completed", "partial"] },
    "planId": { "$ref": "#/$defs/id" },
    "planFingerprint": { "$ref": "#/$defs/sha256" },
    "toolkitVersion": { "$ref": "#/$defs/version" },
    "projectRoot": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "removedEnvironmentVariables": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageGap" }
    },
    "observationBoundary": { "$ref": "#/$defs/observationBoundary" },
    "containmentWarning": { "const": "Commands run as local processes with the current user privileges; this is not a security sandbox and does not block network or out-of-project filesystem access." },
    "disclaimer": { "const": "This report reduces uncertainty by recording checks and evidence. It does not certify that the application is production ready, secure, compliant, or free of defects." }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:unknown|[0-9]+\\.[0-9]+\\.[0-9]+)$"
    },
    "category": {
      "enum": ["build", "test", "type-check", "lint"]
    },
    "coverageGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "$ref": "#/$defs/category" },
        "reason": { "type": "string", "minLength": 1 },
        "workspace": { "type": "string", "minLength": 1 }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["added", "modified", "removed"] }
      }
    },
    "observationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "rootIdentity",
        "versionControlDirectories",
        "artifactDirectories",
        "coverageDirectories",
        "distributionDirectories",
        "dependencyDirectories",
        "exactArtifactExclusions",
        "symlinks",
        "nonRegularFiles",
        "inaccessiblePaths",
        "metadata"
      ],
      "properties": {
        "policyVersion": { "const": "project-observation/0.1" },
        "rootIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["realPath", "device", "inode"],
          "properties": {
            "realPath": { "type": "string", "minLength": 1 },
            "device": { "type": "string", "pattern": "^[0-9]+$" },
            "inode": { "type": "string", "pattern": "^[0-9]+$" }
          }
        },
        "versionControlDirectories": { "type": "array", "prefixItems": [{ "const": ".git" }], "minItems": 1, "maxItems": 1 },
        "artifactDirectories": { "type": "array", "prefixItems": [{ "const": ".postvibe" }], "minItems": 1, "maxItems": 1 },
        "coverageDirectories": { "type": "array", "prefixItems": [{ "const": "coverage" }], "minItems": 1, "maxItems": 1 },
        "distributionDirectories": { "type": "array", "prefixItems": [{ "const": "dist" }], "minItems": 1, "maxItems": 1 },
        "dependencyDirectories": { "type": "array", "prefixItems": [{ "const": "node_modules" }], "minItems": 1, "maxItems": 1 },
        "exactArtifactExclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "symlinks": { "const": "not-followed" },
        "nonRegularFiles": { "const": "not-observed" },
        "inaccessiblePaths": { "const": "observation-fails" },
        "metadata": { "const": "content-sha256-only" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commandId", "status", "exitCode", "signal", "output", "outputTruncated", "fileChanges"],
      "properties": {
        "commandId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["passed", "failed", "timed-out", "could-not-start", "interrupted", "unverified"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] },
        "output": { "type": "string", "maxLength": 262144 },
        "outputTruncated": { "type": "boolean" },
        "fileChanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileChange" }
        },
        "unverifiedReason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
